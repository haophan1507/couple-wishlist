{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    ".output/**",
    "dist/**",
    ".tanstack/**",
    "node_modules/**",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  }
}
